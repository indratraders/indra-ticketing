NEXT_PUBLIC_APP_NAME="Indra Traders Test Drive"

# false = use SQL Server. true = in-memory demo store (no database).
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# Session signing key — generate a long random string for production.
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Set false when the app is served over HTTP on the LAN (typical Windows server).
# Set true only when the site is HTTPS.
COOKIE_SECURE=false

# Required on Vercel so tokens do not reset between serverless instances.
# Prefer Supabase (already connected via Vercel Storage / Marketplace):
# POSTGRES_URL=...
# POSTGRES_PRISMA_URL=...
# Then run: npm run db:supabase
#
# Optional Redis / KV alternative:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# SQL Server
# Same machine as SQL Server: localhost
# Another machine on the LAN: the SQL host name or IP
DB_SERVER=localhost
DB_PORT=1433
DB_USER=your-sql-user
DB_PASSWORD=your-sql-password
DB_NAME=indra_ticketing
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# Named instance only (leave empty for the default instance on port 1433)
# DB_INSTANCE=
